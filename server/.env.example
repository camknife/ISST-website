# 企业微信智能表格对接配置
# 复制为 .env 后填写真实值；.env 请勿提交 git / 公开

# 监听端口（避开同机 pakfront 的 3000，ISST 用 3002）
PORT=3002

# 企业微信凭证（管理后台 → 我的企业 → 企业信息 / 应用管理）
WECOM_CORP_ID=
WECOM_SECRET=
# WECOM_AGENTID 备用（部分接口可能需要，当前写入用不到）

# 智能表格（ISST 课程咨询表 docid；sheet_id 以 get_sheet 查询为准，默认 q979lj）
WECOM_DOCID=s3_ALgAhxQ7AKwCNrA5pBe8CQDWGSq1J_a
WECOM_SHEET_ID=q979lj
